{
  "name": "aura-collection-engine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "contract:compile": "node scripts/deploy-aura-collection.mjs --compile-only",
    "contract:compile:v2": "node scripts/compile-aura-v2.mjs",
    "contract:authorizer:setup": "node scripts/setup-mint-authorizer.mjs",
    "contract:deploy": "node scripts/deploy-aura-collection.mjs",
    "contract:deploy:v2": "node scripts/deploy-aura-collection-v2.mjs",
    "contract:deploy:v2:dry-run": "node scripts/deploy-aura-collection-v2.mjs --dry-run",
    "contract:verify": "node scripts/verify-aura-collection.mjs",
    "contract:verify:v2": "node scripts/verify-aura-collection-v2.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "ethers": "^6.17.0",
    "jszip": "^3.10.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "solc": "^0.8.37",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "undici": "^8.10.2",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
